# Copy to `.env` and fill in. `.env` is gitignored - NEVER commit real values.#ORG_NAME=

GOOGLE_APPLICATION_CREDENTIALS=

# The client's infrastructure identifiers - confidential, never hardcoded.
BIGQUERY_PROJECT=
BIGQUERY_DATASET=
BIGQUERY_REF_DATASET=
BIGQUERY_MASTER_TABLE=
BIGQUERY_CUSTOMERS_TABLE=
# Optional: set if the dataset is not in the default multi-region.
BIGQUERY_LOCATION=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- LangSmith observability (Section 6.1) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=insight-agent
afy-insight-agent

# --- Query guardrails (Section 5.3 / Section 10) ---
MAX_RESULT_ROWS=50
QUERY_TIMEOUT_SECONDS=60
# Hard ceiling on bytes a single query may bill (default 2 GiB).
MAX_BYTES_BILLED=2147483648
